[core]
        pager = delta
        hooksPath = /Users/jeremy/.git-hooks
[alias]
        mainbranch = "!git remote show origin | grep \"HEAD branch\" | cut -d: -f 2"
        co = checkout
        cm = !git commit -m
        st = status
        ca = commit --amend --no-edit
        pf = push -f
        p = push
        d = diff
        ds = diff --staged
        cob = checkout -b
        ec = config --global -e
        up = "!f() { TARGET_BRANCH=$(git mainbranch); git pull origin ${TARGET_BRANCH} && git submodule update --init && git bclean ${TARGET_BRANCH} && git delete-squashed ${TARGET_BRANCH}  && git remote prune origin; }; f"
        save = !git add -A && git commit -m 'SAVEPOINT' --no-verify
        wip = !git add -u && git commit -m 'WIP' --no-verify
        undo = reset HEAD~1 --mixed
        wipe = !git add -A && git commit -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard
        bclean = "!f() { git branch --merged ${1-master} | grep -v " ${1-master}$" | xargs git branch -d; }; f"
        squash = "!git rebase -v -i $(git mainbranch)"
	abs = "!git-absorb"
        delete-squashed = "!f() { local targetBranch=${1:-main} && git checkout -q $targetBranch && git branch --merged | grep -v \"\\*\" | xargs -n 1 git branch -d && git for-each-ref refs/heads/ \"--format=%(refname:short)\" | while read branch; do mergeBase=$(git merge-base $targetBranch $branch) && [[ $(git cherry $targetBranch $(git commit-tree $(git rev-parse $branch^{tree}) -p $mergeBase -m _)) == \"-\"* ]] && git branch -D $branch; done; }; f"
[push]
	default = current
[rerere]
	enabled = true
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/

[delta]
navigate = true
side-by-side = false
line-numbers = true
dark = true # Use 'light' for light themes
[user]
	email = jemoseley@microsoft.com
	name = jmoseley
[pull]
	rebase = false
[credential]
	username = jmoseley
	helper = "!f() { test \"$1\" = get && echo \"password=$GITHUB_TOKEN\"; }; f"
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
